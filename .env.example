# FindJob Environment Variables
# Copy this file to .env and fill in the values

# JWT secret: bắt buộc, tối thiểu 32 ký tự và KHÔNG dùng giá trị mẫu.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-chars

# Server port
PORT=3000

# Thư mục lưu SQLite (mặc định: thư mục server)
# DATA_DIR=./server

# CORS: chỉ bật khi frontend chạy ở origin khác. Mặc định tắt.
# CORS_ORIGIN=https://your-domain.com

# Chỉ đặt =1 khi chạy sau reverse proxy (nginx, Cloudflare...) để lấy đúng IP.
# Để trống khi chạy trực tiếp, tránh giả mạo X-Forwarded-For.
# TRUST_PROXY=1

# Tài khoản admin đầu tiên (tạo tự động khi database chưa có admin).
# Nếu bỏ trống ADMIN_PASSWORD, hệ thống sinh mật khẩu ngẫu nhiên và in ra log một lần.
ADMIN_EMAIL=admin@findjob.vn
ADMIN_PASSWORD=change-this-admin-password

# Scraper
ENABLE_BROWSER=true
# Chỉ cần khi máy chạy sau proxy (vd: mạng công ty): Chromium không tự đọc
# biến *_PROXY nên cần khai báo riêng cho trình duyệt. Để trống nếu không dùng.
# BROWSER_PROXY=http://user:pass@host:port
SCRAPE_TIMEOUT=40000
MAX_JOBS_PER_PLATFORM=20
