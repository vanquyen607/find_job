# FindJob Environment Variables
# Copy this file to .env and fill in the values
# v2: no accounts, no database — the app is open-access and stateless.
# Saved jobs live in each visitor's browser (localStorage).

# Server port
PORT=3000

# CORS: chỉ bật khi frontend chạy ở origin khác. Mặc định tắt.
# CORS_ORIGIN=https://your-domain.com

# Chỉ đặt =1 khi chạy sau reverse proxy (nginx, Cloudflare, Render...)
# để lấy đúng IP cho rate limit. Để trống khi chạy trực tiếp,
# tránh giả mạo X-Forwarded-For.
# TRUST_PROXY=1

# Scraper
ENABLE_BROWSER=true
# Chỉ cần khi máy chạy sau proxy (vd: mạng công ty): Chromium không tự đọc
# biến *_PROXY nên cần khai báo riêng cho trình duyệt. Để trống nếu không dùng.
# BROWSER_PROXY=http://user:pass@host:port
SCRAPE_TIMEOUT=40000
MAX_JOBS_PER_PLATFORM=20
